# Pooled (host com -pooler). Usada pelo app na Vercel e no npm run dev.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Direct, sem -pooler. Usada só pelo Drizzle na migração.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Segredo do login (obrigatório). Gere com: npx auth secret
# Nunca compartilhe nem comite o valor real.
AUTH_SECRET=

# Local: http://localhost:3000
# Produção: https://mundobjj.vercel.app
AUTH_URL=http://localhost:3000

# Necessário na Vercel
AUTH_TRUST_HOST=true

# Conta admin criada por npm run db:seed:admin
ADMIN_EMAIL=admin@mundobjj.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin Mundo BJJ
